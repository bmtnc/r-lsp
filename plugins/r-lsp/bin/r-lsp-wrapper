#!/bin/bash
# R LSP wrapper for Claude Code.
#
# Sets up the environment and starts the R language server with the plugin's
# patches (bin/r-lsp-server.R): renv-aware library paths, index status
# events, complete cross-file answers, and workspaces for other repositories.
# The patches are documented in that file and in the README.
#
# Lint profile: when a project has no .lintr (and there is no ~/.lintr),
# lintr falls back to the plugin's agent profile (lintr/agent_linters.R):
# likely bugs only, no style, tidyverse-aware. It is found through
# R_USER_CONFIG_DIR. Set R_LSP_AGENT_LINTERS=false to use lintr's defaults.
#
# Multi-repo note: Claude Code runs ONE language server per session, rooted
# at the session's launch directory. A file opened from another repository
# gets that repository added as a second workspace (indexed, with its renv
# library), so navigation works there too.

SCRIPT="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
PLUGIN_ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
export R_LSP_PLUGIN_ROOT="$PLUGIN_ROOT"
if [ "${R_LSP_AGENT_LINTERS:-true}" != "false" ] && [ -z "${R_USER_CONFIG_DIR:-}" ]; then
  export R_USER_CONFIG_DIR="$PLUGIN_ROOT/lintr/user-config"
fi

# --vanilla: renv's .Rprofile must not change .libPaths() before the project
# root is known. The server program is a file, not an -e string: no shell
# escaping, no size limit.
exec R --vanilla --no-echo --file="$PLUGIN_ROOT/bin/r-lsp-server.R"
