#!/bin/bash
# r-colmap [--json] [--root DIR] [--file PATH ...] [--source NAME ...] [COLUMN ...]
# r-colmap [--json] [--root DIR] --diff [REF]
#   A map of the data the R project reads: every source with its columns,
#   where the code uses, creates (and from what), overwrites or drops each
#   column, what the code writes and who reads it. With COLUMN, every site
#   that touches it and its lineage; --diff, what the working tree's changes
#   touch. The data-side counterpart of r-callmap; see scripts/colmap-lib.R.
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
. "$here/../scripts/project-root.sh"
# An explicit --root later in "$@" wins over this default.
exec Rscript --vanilla "$here/../scripts/r-colmap.R" --root "$(project_root "$PWD")" "$@"
