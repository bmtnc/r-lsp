#!/bin/bash
# r-colcheck [--json] [--steps] [--root DIR] FILE.R ...
#   Check bare column names in tidyverse code against the real columns of the
#   data the code reads. See scripts/colcheck-lib.R for what is resolved.
#
# r-colcheck learn KEY 'EXPR' [--source FILE.R ...] [--load-all] [--root DIR]
# r-colcheck refresh [--stale] [KEY ...] [--root DIR]
# r-colcheck schemas [--root DIR]
# r-colcheck forget KEY [--root DIR]
# r-colcheck discover [--root DIR]
# r-colcheck learn --all [--dry-run] [--root DIR]
#   The schema cache (.colcheck/schemas.json) for data the checker cannot
#   open: S3 objects, databases, project loaders. `learn` evaluates EXPR in
#   the project (renv active, no --vanilla) and records the column names;
#   `refresh` re-runs the cached expressions with the flags they were
#   learned with. Exit 0 done, 1 when the work failed (an expression that
#   does not evaluate, a key not cached), 2 on wrong arguments.
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
. "$here/../scripts/project-root.sh"

case "${1:-}" in
  help|--help|-h)
    exec Rscript --vanilla "$here/../scripts/r-colcheck.R" --help
    ;;
  learn|refresh|schemas|forget|discover)
    cmd="$1"; shift
    root=""
    rest=()
    while [ $# -gt 0 ]; do
      if [ "$1" = "--root" ]; then
        if [ $# -lt 2 ]; then echo "r-colcheck: --root needs a directory" >&2; exit 2; fi
        root="$2"; shift 2; continue
      fi
      if [ "$1" = "--source" ] && [ $# -ge 2 ]; then
        # relative to where the command was typed, made absolute before the cd below
        src="$2"
        case "$src" in /*) ;; *) [ -e "$src" ] && src="$(cd "$(dirname "$src")" && pwd -P)/$(basename "$src")" ;; esac
        rest+=("$1" "$src"); shift 2; continue
      fi
      rest+=("$1"); shift
    done
    # the project root: where .Rprofile (renv) and relative paths in EXPR live
    [ -n "$root" ] || root="$(project_root "$PWD")"
    export R_LSP_INVOKE_DIR="$PWD"
    cd "$root" || exit 1
    exec Rscript "$here/../scripts/colcheck-learn.R" "$cmd" "${rest[@]}"
    ;;
esac

exec Rscript --vanilla "$here/../scripts/r-colcheck.R" "$@"
